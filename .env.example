# =============================================================================
# MatrixEdu — Environment Variables Template
# =============================================================================
# USAGE:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in your real values in .env.local
#   3. NEVER commit .env.local or any file with real secrets to git
#   4. Ensure .env.local is in .gitignore (Create React App handles this)
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (required — authentication & database)
# Get from: https://app.supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Only the Client ID is used in the browser (safe to expose).
# The Client Secret must NEVER be used on the frontend — use a backend route.
# -----------------------------------------------------------------------------
REACT_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# GEMINI API KEY  ⚠️  SECURITY CRITICAL
# =============================================================================
# The Gemini API key must NEVER be placed in frontend environment variables.
# Prefix REACT_APP_ variables are bundled into the JS file and visible
# to anyone who inspects your production bundle.
#
# CORRECT pattern:
#   - Store the key server-side (Node.js / Cloud Function / Edge Function)
#   - Your frontend calls YOUR OWN backend endpoint (e.g. POST /api/ai/generate)
#   - Your backend validates the user session, then calls Gemini on their behalf
#   - The Gemini key is stored as a server-only env var (no REACT_APP_ prefix)
#
# Example server-side env var (set in Vercel / Railway / Cloud Run secrets):
#   GEMINI_API_KEY=AIzaSy...
#
# DO NOT DO THIS (insecure — key exposed in bundle):
#   REACT_APP_GEMINI_API_KEY=AIzaSy...   ← NEVER
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...   # server-side only — never prefix with REACT_APP_

# -----------------------------------------------------------------------------
# OPENAI / OTHER AI PROVIDERS  ⚠️  Same rule — server-side only
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...      # server-side only

# -----------------------------------------------------------------------------
# PAYMENT — ANTOM / ALIPAY
# Get from: Antom merchant dashboard
# -----------------------------------------------------------------------------
REACT_APP_ANTOM_CLIENT_ID=YOUR_ANTOM_CLIENT_ID
REACT_APP_ANTOM_ENVIRONMENT=sandbox
# ANTOM_MERCHANT_PRIVATE_KEY=...   # server-side only — sign requests on backend

# -----------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE VERIFICATION
# Paste the content value from: Search Console → Add Property → HTML tag
# Then uncomment the <meta> tag in public/index.html
# -----------------------------------------------------------------------------
# REACT_APP_GOOGLE_SITE_VERIFICATION=YOUR_VERIFICATION_CODE

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
REACT_APP_SITE_URL=https://matrixedu.ai
REACT_APP_ENV=production

# =============================================================================
# SERVER-SIDE SECURITY CHECKLIST (for your Node.js / Edge API):
# =============================================================================
# ✅ Store all AI API keys as server environment secrets (Vercel/Railway/GCP)
# ✅ Validate Supabase JWT tokens on every API request before calling AI APIs
# ✅ Rate-limit API endpoints per user (e.g. 20 AI calls/min/user)
# ✅ Never log API keys, tokens, or user PII to console
# ✅ Set CORS policy to only allow https://matrixedu.ai origin
# ✅ Use HTTPS everywhere — no plain HTTP in production
# ✅ Restrict Gemini API key in Google Cloud console to your server's IP/domain
# ✅ Rotate keys immediately if accidentally committed to git
# =============================================================================
